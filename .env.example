# Copy this file to `.env.local` and fill in values as needed.
# All variables here are OPTIONAL — the app runs without a .env file.

# Public base URL of the deployed site. Used for SEO metadata, sitemap, and robots.
# Falls back to the production Vercel URL if unset. Must be an absolute URL.
NEXT_PUBLIC_SITE_URL=https://ruchit-pahadia-dashboard.vercel.app

# GitHub personal access token (classic or fine-grained, no scopes required for
# public repos). Used by /api/git-commit to raise the GitHub API rate limit from
# 60 to 5000 requests/hour. Leave unset for unauthenticated requests.
GITHUB_TOKEN=
